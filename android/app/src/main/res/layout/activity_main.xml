<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vh_background">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Карта Москвы" />

    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_panel"
        android:backgroundTint="@color/vh_surface_solid"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/compactSearchRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_search"
                app:tint="@color/vh_text_secondary" />

            <TextView
                android:id="@+id/compactSearchButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:hint="@string/search_destination"
                android:paddingStart="2dp"
                android:paddingEnd="12dp"
                android:textColor="@color/vh_text_primary"
                android:textColorHint="@color/vh_text_tertiary"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expandedSearchContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/vh_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/fromField"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/search_origin"
                    android:imeOptions="actionNext"
                    android:inputType="textPostalAddress"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:textColor="@color/vh_text_primary"
                    android:textColorHint="@color/vh_text_tertiary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/clearFromButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/clear_origin"
                    android:gravity="center"
                    android:text="×"
                    android:textColor="@color/vh_text_tertiary"
                    android:textSize="24sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="40dp"
                android:background="@color/vh_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="Б"
                    android:textColor="@color/vh_error"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/toField"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/search_destination"
                    android:imeOptions="actionSearch"
                    android:inputType="textPostalAddress"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:textColor="@color/vh_text_primary"
                    android:textColorHint="@color/vh_text_tertiary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/clearToButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/clear_destination"
                    android:gravity="center"
                    android:text="×"
                    android:textColor="@color/vh_text_tertiary"
                    android:textSize="24sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/suggestionsScroll"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/suggestionsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/closeSearchButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/search_close"
                    android:gravity="center"
                    android:text="⌃"
                    android:textColor="@color/vh_text_secondary"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/routeButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_primary"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/search_action"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quickActions"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="top"
        android:layout_marginStart="20dp"
        android:layout_marginTop="78dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/homeQuickButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/vh_surface_solid"
            android:drawableStart="@drawable/ic_home"
            android:drawablePadding="6dp"
            android:elevation="5dp"
            android:gravity="center"
            android:text="@string/quick_home"
            android:textColor="@color/vh_text_primary"
            android:textSize="13sp" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/workQuickButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/vh_surface_solid"
            android:drawableStart="@drawable/ic_work"
            android:drawablePadding="6dp"
            android:elevation="5dp"
            android:gravity="center"
            android:text="@string/quick_work"
            android:textColor="@color/vh_text_primary"
            android:textSize="13sp" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/nearbyQuickButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/vh_surface_solid"
            android:drawableStart="@drawable/ic_nearby"
            android:drawablePadding="6dp"
            android:elevation="5dp"
            android:gravity="center"
            android:text="@string/quick_nearby"
            android:textColor="@color/vh_text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="20dp"
        android:layout_marginTop="130dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_status"
        android:backgroundTint="@color/vh_surface_solid"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/journeyRow"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/journeyImage"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@string/journey_progress"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/journey_progress"
                    android:textColor="@color/vh_text_tertiary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/journeyStageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/vh_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Подготавливаем данные…"
                android:textColor="@color/vh_text_tertiary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0%"
                android:textColor="@color/vh_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="0" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="end"
            android:layout_marginTop="5dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Повторить"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/locationButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_round_button"
        android:backgroundTint="@color/vh_surface_solid"
        android:contentDescription="@string/my_location"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@drawable/ic_my_location"
        android:translationY="-34dp"
        app:tint="@color/vh_primary" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_round_button"
        android:backgroundTint="@color/vh_surface_solid"
        android:contentDescription="@string/settings"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@drawable/ic_tune"
        android:translationY="28dp"
        app:tint="@color/vh_primary" />

    <LinearLayout
        android:id="@+id/locationActionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="304dp"
        android:background="@drawable/bg_status"
        android:backgroundTint="@color/vh_surface_solid"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/locationActionMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/vh_text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/locationSecondaryAction"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/permission_choose_map"
                android:textAllCaps="false"
                android:textColor="@color/vh_primary" />

            <Button
                android:id="@+id/locationPrimaryAction"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_primary"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/permission_allow"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nearbyPanel"
        android:layout_width="match_parent"
        android:layout_height="212dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="82dp"
        android:background="@drawable/bg_sheet"
        android:backgroundTint="@color/vh_surface_solid"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_handle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/nearby_title"
            android:textColor="@color/vh_text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nearbyStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/nearby_loading"
            android:textColor="@color/vh_text_tertiary"
            android:textSize="13sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/nearbyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/routeResultsContainer"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="82dp"
        android:background="@drawable/bg_sheet"
        android:backgroundTint="@color/vh_surface_solid"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_handle" />

        <HorizontalScrollView
            android:id="@+id/routeFiltersScroll"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/routeFiltersPanel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/routeResultsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/routeResultsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabEmptyPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="82dp"
        android:background="@drawable/bg_sheet"
        android:backgroundTint="@color/vh_surface_solid"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tabEmptyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/vh_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/vh_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/osmAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="84dp"
        android:background="@color/vh_surface"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        android:text="© OpenStreetMap contributors"
        android:textColor="@color/vh_text_tertiary"
        android:textSize="9sp" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_nav"
        android:backgroundTint="@color/vh_surface_solid"
        android:elevation="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/mapNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_map"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="@string/nav_map"
            android:textColor="@color/vh_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/routesNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_routes"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="@string/nav_routes"
            android:textColor="@color/vh_text_tertiary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/transportNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_transport"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="@string/nav_transport"
            android:textColor="@color/vh_text_tertiary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/favoritesNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_star"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="@string/nav_favorites"
            android:textColor="@color/vh_text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settingsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vh_scrim"
        android:clickable="true"
        android:elevation="32dp"
        android:focusable="true"
        android:visibility="gone">

        <ScrollView
            android:layout_width="340dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@color/vh_surface_solid"
            android:elevation="24dp"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/settingsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings"
                        android:textColor="@color/vh_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/closeSettingsButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/close"
                        android:gravity="center"
                        android:text="×"
                        android:textColor="@color/vh_text_secondary"
                        android:textSize="28sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/settings_map"
                    android:textColor="@color/vh_text_tertiary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/showStopsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/show_stops"
                    android:textColor="@color/vh_text_primary"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/showTransportSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/show_transport"
                    android:textColor="@color/vh_text_primary"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/darkThemeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/dark_theme"
                    android:textColor="@color/vh_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/settings_routes"
                    android:textColor="@color/vh_text_tertiary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/lessWalkingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/less_walking"
                    android:textColor="@color/vh_text_primary"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/avoidTransfersSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/avoid_transfers"
                    android:textColor="@color/vh_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/settings_data"
                    android:textColor="@color/vh_text_tertiary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/appVersionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/vh_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/runtimeVersionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/runtime_version_unavailable"
                    android:textColor="@color/vh_text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/checkDataButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input"
                    android:backgroundTint="@color/vh_surface_muted"
                    android:text="@string/check_updates"
                    android:textAllCaps="false"
                    android:textColor="@color/vh_primary"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</FrameLayout>
