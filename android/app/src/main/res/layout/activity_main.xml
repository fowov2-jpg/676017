<?xml version="1.0" encoding="utf-8"?>
<app.humanrouter.VremyaHodomChromeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FAFC">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_panel"
        android:elevation="18dp"
        android:orientation="vertical"
        android:padding="7dp"
        android:visibility="visible">

        <EditText
            android:id="@+id/fromField"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#FF475467"
                android:textSize="31sp" />

            <EditText
                android:id="@+id/toField"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_destination"
                android:imeOptions="actionDone"
                android:inputType="textPostalAddress"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="8dp"
                android:textColor="#FF101828"
                android:textColorHint="#FF98A2B3"
                android:textSize="20sp" />

            <Button
                android:id="@+id/routeButton"
                android:layout_width="92dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_primary"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Найти"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/suggestionsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quickActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="98dp"
        android:elevation="13dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/homeQuickButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="⌂  Дом"
            android:textColor="#FF1D2939"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/workQuickButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minWidth="104dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="▣  Работа"
            android:textColor="#FF1D2939"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nearbyQuickButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minWidth="98dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="⌖  Рядом"
            android:textColor="#FF1D2939"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginTop="154dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_panel"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Подготавливаем данные ВремяХодом…"
                android:textColor="#FF475467"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0%"
                android:textColor="#FF101828"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="0" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Повторить"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/locationButton"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_chip"
        android:elevation="15dp"
        android:gravity="center"
        android:text="◎"
        android:textColor="#FF287BFF"
        android:textSize="30sp"
        android:translationY="-40dp" />

    <ImageButton
        android:id="@+id/settingsHandle"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_chip"
        android:contentDescription="@string/settings"
        android:elevation="15dp"
        android:padding="15dp"
        android:src="@drawable/ic_tune"
        android:translationY="38dp"
        app:tint="#FF287BFF" />

    <LinearLayout
        android:id="@+id/nearbyPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_panel"
        android:elevation="20dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#FFD0D5DD" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Рядом"
            android:textColor="#FF101828"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="#FFEAF3FF"
                android:gravity="center"
                android:text="▣"
                android:textColor="#FF287BFF"
                android:textSize="23sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Автобусы"
                    android:textColor="#FF101828"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ближайшие остановки по вашей геопозиции"
                    android:textColor="#FF667085"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#FF98A2B3"
                android:textSize="28sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFF0F2F5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="#FFF3EBFF"
                android:gravity="center"
                android:text="◇"
                android:textColor="#FF8657D9"
                android:textSize="23sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Трамваи"
                    android:textColor="#FF101828"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Маршруты и остановки рядом"
                    android:textColor="#FF667085"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#FF98A2B3"
                android:textSize="28sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFF0F2F5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="#FFFFE9EC"
                android:gravity="center"
                android:text="M"
                android:textColor="#FFE52B3D"
                android:textSize="21sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Метро и МЦК"
                    android:textColor="#FF101828"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Станции и пересадки поблизости"
                    android:textColor="#FF667085"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#FF98A2B3"
                android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/osmAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="92dp"
        android:background="#EFFFFFFF"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp"
        android:text="© OpenStreetMap contributors"
        android:textColor="#FF667085"
        android:textSize="9sp" />

    <app.humanrouter.TripResultsLayout
        android:id="@+id/routeResultsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_panel"
        android:elevation="22dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_panel"
        android:elevation="22dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/mapNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▱&#10;Карта"
            android:textColor="#FF287BFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/routesNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="↝&#10;Маршруты"
            android:textColor="#FF667085"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/transportNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣&#10;Транспорт"
            android:textColor="#FF667085"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/favoritesNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="☆&#10;Избранное"
            android:textColor="#FF667085"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#FFFFFFFF"
        android:elevation="28dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textColor="#FF101828"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/closeSettingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="×"
                android:textColor="#FF475467"
                android:textSize="28sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Отображение"
                    android:textColor="#FF344054"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/showStopsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Показывать остановки"
                    android:textColor="#FF101828"
                    android:textSize="15sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/showTransportSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Показывать транспорт"
                    android:textColor="#FF101828"
                    android:textSize="15sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/darkThemeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Тёмная тема"
                    android:textColor="#FF101828"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Маршруты"
                    android:textColor="#FF344054"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/lessWalkingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Меньше ходьбы"
                    android:textColor="#FF101828"
                    android:textSize="15sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/avoidTransfersSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Избегать пересадок"
                    android:textColor="#FF101828"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Карта"
                    android:textColor="#FF344054"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/rotateMapSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Поворот карты"
                    android:textColor="#FF101828"
                    android:textSize="15sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/tiltMapSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Наклон карты"
                    android:textColor="#FF101828"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Данные"
                    android:textColor="#FF344054"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/runtimeVersionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Версия данных: проверяем…"
                    android:textColor="#FF667085"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/checkDataButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_primary"
                    android:text="Проверить данные"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <ImageButton
        android:id="@+id/searchHandle"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="Поиск маршрута"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/navHandle"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="Меню"
        android:visibility="gone" />

    <View
        android:id="@+id/leftEdgeZone"
        android:layout_width="18dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|start"
        android:background="#00000000" />

    <View
        android:id="@+id/rightEdgeZone"
        android:layout_width="18dp"
        android:layout_height="360dp"
        android:layout_gravity="bottom|end"
        android:background="#00000000" />

</app.humanrouter.VremyaHodomChromeLayout>
