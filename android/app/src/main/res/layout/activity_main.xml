<?xml version="1.0" encoding="utf-8"?>
<app.humanrouter.VremyaHodomChromeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F7FA">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_panel"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="7dp">

        <EditText
            android:id="@+id/fromField"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:importantForAccessibility="no"
            android:text="Москва"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_search"
                app:tint="#FF475467" />

            <EditText
                android:id="@+id/toField"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_destination"
                android:imeOptions="actionDone"
                android:inputType="textPostalAddress"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="6dp"
                android:textColor="#FF101828"
                android:textColorHint="#FF98A2B3"
                android:textSize="19sp" />

            <Button
                android:id="@+id/routeButton"
                android:layout_width="104dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_primary"
                android:maxLines="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Найти"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/suggestionsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quickActions"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:layout_marginStart="20dp"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/homeQuickButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:drawableStart="@drawable/ic_home"
            android:drawablePadding="8dp"
            android:elevation="7dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/quick_home"
            android:textColor="#FF1D2939"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/workQuickButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:drawableStart="@drawable/ic_work"
            android:drawablePadding="8dp"
            android:elevation="7dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/quick_work"
            android:textColor="#FF1D2939"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/nearbyQuickButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:drawableStart="@drawable/ic_nearby"
            android:drawablePadding="8dp"
            android:elevation="7dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/quick_nearby"
            android:textColor="#FF1D2939"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="20dp"
        android:layout_marginTop="146dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_status"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Подготавливаем данные…"
                android:textColor="#FF667085"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0%"
                android:textColor="#FF344054"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="0" />
        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="5dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Повторить"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/locationButton"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="Моё местоположение"
        android:elevation="10dp"
        android:padding="14dp"
        android:src="@drawable/ic_my_location"
        android:translationY="-34dp"
        app:tint="#FF287BFF" />

    <ImageButton
        android:id="@+id/settingsHandle"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/settings"
        android:elevation="10dp"
        android:padding="14dp"
        android:src="@drawable/ic_tune"
        android:translationY="32dp"
        app:tint="#FF287BFF" />

    <LinearLayout
        android:id="@+id/nearbyPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="86dp"
        android:background="@drawable/bg_sheet"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_handle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Рядом"
            android:textColor="#FF101828"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/nearbyBusRow"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_bus_badge">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bus"
                    app:tint="#FF287BFF" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Автобус"
                    android:textColor="#FF101828"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ближайшие остановки по геопозиции"
                    android:textColor="#FF667085"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="рядом"
                android:textColor="#FF287BFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFF0F2F5" />

        <LinearLayout
            android:id="@+id/nearbyTramRow"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_tram_badge">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tram"
                    app:tint="#FF8657D9" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Трамвай" android:textColor="#FF101828" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Маршруты и остановки поблизости" android:textColor="#FF667085" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="рядом" android:textColor="#FF8657D9" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFF0F2F5" />

        <LinearLayout
            android:id="@+id/nearbyMetroRow"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_metro_badge">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_metro"
                    app:tint="#FFE52B3D" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Метро и МЦК" android:textColor="#FF101828" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Станции и пересадки поблизости" android:textColor="#FF667085" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="рядом" android:textColor="#FFE52B3D" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/osmAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="82dp"
        android:background="#D9FFFFFF"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        android:text="© OpenStreetMap contributors"
        android:textColor="#FF667085"
        android:textSize="9sp" />

    <app.humanrouter.TripResultsLayout
        android:id="@+id/routeResultsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="86dp"
        android:background="@drawable/bg_sheet"
        android:elevation="20dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_nav"
        android:elevation="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/mapNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_map"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:text="@string/nav_map"
            android:textColor="#FF287BFF"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/routesNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_routes"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:text="@string/nav_routes"
            android:textColor="#FF667085"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/transportNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_transport"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:text="@string/nav_transport"
            android:textColor="#FF667085"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/favoritesNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_star"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:text="@string/nav_favorites"
            android:textColor="#FF667085"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="330dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#FFFFFFFF"
        android:elevation="28dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Настройки"
                android:textColor="#FF101828"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/closeSettingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="×"
                android:textColor="#FF475467"
                android:textSize="30sp" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Карта" android:textColor="#FF667085" android:textSize="12sp" android:textStyle="bold" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/showStopsSwitch" android:layout_width="match_parent" android:layout_height="52dp" android:text="Показывать остановки" android:textColor="#FF1D2939" android:textSize="15sp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/showTransportSwitch" android:layout_width="match_parent" android:layout_height="52dp" android:text="Показывать транспорт" android:textColor="#FF1D2939" android:textSize="15sp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/rotateMapSwitch" android:layout_width="match_parent" android:layout_height="52dp" android:text="Вращение карты" android:textColor="#FF1D2939" android:textSize="15sp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/tiltMapSwitch" android:layout_width="match_parent" android:layout_height="52dp" android:text="Наклон карты" android:textColor="#FF1D2939" android:textSize="15sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Маршруты" android:textColor="#FF667085" android:textSize="12sp" android:textStyle="bold" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/lessWalkingSwitch" android:layout_width="match_parent" android:layout_height="52dp" android:text="Меньше ходьбы" android:textColor="#FF1D2939" android:textSize="15sp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/avoidTransfersSwitch" android:layout_width="match_parent" android:layout_height="52dp" android:text="Избегать пересадок" android:textColor="#FF1D2939" android:textSize="15sp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/darkThemeSwitch" android:layout_width="match_parent" android:layout_height="52dp" android:text="Тёмная тема" android:textColor="#FF1D2939" android:textSize="15sp" />

        <Space android:layout_width="match_parent" android:layout_height="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Данные" android:textColor="#FF667085" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/runtimeVersionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Runtime: —" android:textColor="#FF475467" android:textSize="13sp" />
        <Button
            android:id="@+id/checkDataButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:text="Проверить обновления"
            android:textAllCaps="false"
            android:textColor="#FF287BFF"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton android:id="@+id/searchHandle" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="@null" />
    <ImageButton android:id="@+id/navHandle" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="@null" />
    <View android:id="@+id/leftEdgeZone" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <View android:id="@+id/rightEdgeZone" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

</app.humanrouter.VremyaHodomChromeLayout>
