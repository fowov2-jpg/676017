<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FAFC">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_panel"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="visible">

        <EditText
            android:id="@+id/fromField"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#FF475467"
                android:textSize="30sp" />

            <EditText
                android:id="@+id/toField"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_destination"
                android:imeOptions="actionDone"
                android:inputType="textPostalAddress"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:textColor="#FF111827"
                android:textColorHint="#FF98A2B3"
                android:textSize="18sp" />

            <Button
                android:id="@+id/routeButton"
                android:layout_width="62dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_primary"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Найти"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/suggestionsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="92dp"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/homeQuickButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minWidth="82dp"
            android:text="@string/quick_home"
            android:textColor="#FF1D2939"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/workQuickButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minWidth="90dp"
            android:text="@string/quick_work"
            android:textColor="#FF1D2939"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nearbyQuickButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minWidth="88dp"
            android:text="@string/quick_nearby"
            android:textColor="#FF1D2939"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginTop="146dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_panel"
        android:elevation="11dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Подготавливаем данные ВремяХодом…"
                android:textColor="#FF344054"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0%"
                android:textColor="#FF111827"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Повторить"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/osmAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="92dp"
        android:background="#DFFFFFFF"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp"
        android:text="© OpenStreetMap contributors"
        android:textColor="#FF667085"
        android:textSize="9sp" />

    <app.humanrouter.TripResultsLayout
        android:id="@+id/routeResultsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="82dp"
        android:background="@drawable/bg_panel"
        android:elevation="18dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_panel"
        android:elevation="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/mapNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_map"
            android:textColor="#FF287BFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/routesNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_routes"
            android:textColor="#FF667085"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_transport"
            android:textColor="#FF667085"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_favorites"
            android:textColor="#FF667085"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_panel"
        android:elevation="22dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="invisible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="#FF101828"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Карта"
            android:textColor="#FF344054"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/rotateMapSwitch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Разрешить поворот карты"
            android:textColor="#FF111827"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/tiltMapSwitch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Разрешить наклон карты"
            android:textColor="#FF111827"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Данные"
            android:textColor="#FF344054"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/runtimeVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Версия данных: проверяем…"
            android:textColor="#FF667085"
            android:textSize="13sp" />

        <Button
            android:id="@+id/checkDataButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_primary"
            android:text="Проверить данные"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/settingsHandle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_chip"
        android:contentDescription="@string/settings"
        android:elevation="16dp"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_manage"
        app:tint="#FF287BFF" />

    <ImageButton
        android:id="@+id/searchHandle"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="Поиск маршрута"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/navHandle"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="Меню"
        android:visibility="gone" />

    <View
        android:id="@+id/leftEdgeZone"
        android:layout_width="18dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|start"
        android:background="#00000000" />

    <View
        android:id="@+id/rightEdgeZone"
        android:layout_width="18dp"
        android:layout_height="360dp"
        android:layout_gravity="bottom|end"
        android:background="#00000000" />

</FrameLayout>
