<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FF111827" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Карта"
            android:textStyle="bold"
            android:textColor="#FF344054" />

        <Switch
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Показывать остановки" />

        <Switch
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Показывать транспорт" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Маршруты"
            android:textStyle="bold"
            android:textColor="#FF344054" />

        <Switch
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Избегать лишних пересадок" />

        <Switch
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Предпочитать меньше ходьбы" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Данные"
            android:textStyle="bold"
            android:textColor="#FF344054" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Версия runtime: moscow-runtime-2026-08-14-r2\nОбновление данных — отдельно от приложения"
            android:textColor="#FF667085" />
    </LinearLayout>
</ScrollView>
