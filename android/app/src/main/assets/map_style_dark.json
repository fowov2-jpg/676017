{
  "version": 8,
  "name": "VremyaHodom Dark Base Map",
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": [
        "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0B111A"
      }
    },
    {
      "id": "osm",
      "type": "raster",
      "source": "osm",
      "minzoom": 0,
      "maxzoom": 19,
      "paint": {
        "raster-brightness-max": 0.34,
        "raster-brightness-min": 0.035,
        "raster-contrast": 0.42,
        "raster-saturation": -0.82,
        "raster-opacity": 0.96,
        "raster-fade-duration": 0
      }
    }
  ]
}
