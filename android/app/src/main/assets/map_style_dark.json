{
  "version": 8,
  "name": "VremyaHodom Dark Vector",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {"id":"background","type":"background","paint":{"background-color":"#0B111A"}},
    {"id":"landcover-wood","type":"fill","source":"openmaptiles","source-layer":"landcover","filter":["==",["get","class"],"wood"],"paint":{"fill-color":"#172A22","fill-opacity":0.82}},
    {"id":"landcover-grass","type":"fill","source":"openmaptiles","source-layer":"landcover","filter":["==",["get","class"],"grass"],"paint":{"fill-color":"#14241D","fill-opacity":0.78}},
    {"id":"park","type":"fill","source":"openmaptiles","source-layer":"park","paint":{"fill-color":"#173226","fill-opacity":0.78}},
    {"id":"water","type":"fill","source":"openmaptiles","source-layer":"water","paint":{"fill-color":"#132A40"}},
    {"id":"building","type":"fill","source":"openmaptiles","source-layer":"building","minzoom":13,"paint":{"fill-color":"#202A36","fill-outline-color":"#2C3745"}},
    {"id":"rail","type":"line","source":"openmaptiles","source-layer":"transportation","filter":["match",["get","class"],["rail","transit"],true,false],"paint":{"line-color":"#607086","line-width":["interpolate",["linear"],["zoom"],10,0.5,16,1.6],"line-opacity":0.76}},
    {"id":"road-path","type":"line","source":"openmaptiles","source-layer":"transportation","minzoom":13,"filter":["match",["get","class"],["path","pedestrian","service","track"],true,false],"layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#26303C","line-width":["interpolate",["linear"],["zoom"],13,0.5,18,4]}},
    {"id":"road-minor","type":"line","source":"openmaptiles","source-layer":"transportation","minzoom":11,"filter":["match",["get","class"],["minor","street","street_limited"],true,false],"layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#303B49","line-width":["interpolate",["linear"],["zoom"],11,0.7,18,7]}},
    {"id":"road-major","type":"line","source":"openmaptiles","source-layer":"transportation","filter":["match",["get","class"],["secondary","tertiary","primary","trunk"],true,false],"layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#4B4233","line-width":["interpolate",["linear"],["zoom"],7,0.7,18,10]}},
    {"id":"road-motorway","type":"line","source":"openmaptiles","source-layer":"transportation","filter":["==",["get","class"],"motorway"],"layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#614C36","line-width":["interpolate",["linear"],["zoom"],5,0.7,18,12]}},
    {"id":"road-name","type":"symbol","source":"openmaptiles","source-layer":"transportation_name","minzoom":12,"filter":["match",["geometry-type"],["LineString","MultiLineString"],true,false],"layout":{"symbol-placement":"line","text-field":["coalesce",["get","name:nonlatin"],["get","name"],["get","name:latin"]],"text-font":["Noto Sans Regular"],"text-size":["interpolate",["linear"],["zoom"],12,10,17,13],"text-max-width":10},"paint":{"text-color":"#AAB5C5","text-halo-color":"#0B111A","text-halo-width":1.2}},
    {"id":"place-label","type":"symbol","source":"openmaptiles","source-layer":"place","minzoom":4,"filter":["match",["get","class"],["city","town","village"],true,false],"layout":{"text-field":["coalesce",["get","name:nonlatin"],["get","name"],["get","name:latin"]],"text-font":["Noto Sans Regular"],"text-size":["interpolate",["linear"],["zoom"],4,11,12,16],"text-max-width":9},"paint":{"text-color":"#D5DCE6","text-halo-color":"#0B111A","text-halo-width":1.5}}
  ]
}
