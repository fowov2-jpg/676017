+    private fun applyScreenshotReferencePolish() {
+        // The supplied references use floating white cards over the map instead of opaque
+        // full-width chrome. Keep the existing functional layout and refine its hierarchy.
+        listOf(searchPanel, nearbyPanel, routeResultsContainer, bottomNav).forEach { panel ->
+            panel.elevation = dp(8).toFloat()
+            panel.clipToOutline = true
+        }
+        searchPanel.background = roundedSurface(
+            ContextCompat.getColor(this, R.color.vh_surface_solid),
+            24
+        )
+        nearbyPanel.background = roundedSurface(
+            ContextCompat.getColor(this, R.color.vh_surface_solid),
+            24
+        )
+        routeResultsContainer.background = roundedSurface(
+            ContextCompat.getColor(this, R.color.vh_surface_solid),
+            26
+        )
+        bottomNav.background = roundedSurface(
+            ContextCompat.getColor(this, R.color.vh_surface_solid),
+            22
+        )
+        settingsPanel.elevation = dp(12).toFloat()
+        locationButton.elevation = dp(8).toFloat()
+        settingsButton.elevation = dp(8).toFloat()
+        compactSearchButton.hint = "Куда едем?"
+        compactSearchButton.textSize = 16f
+    }
+    private fun roundedSurface(color: Int, radiusDp: Int): GradientDrawable =
+        GradientDrawable().apply {
+            shape = GradientDrawable.RECTANGLE
+            cornerRadius = dp(radiusDp).toFloat()
+            setColor(color)
+        }
