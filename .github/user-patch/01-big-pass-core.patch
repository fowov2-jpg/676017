     internal fun transactionInProgress(filesRoot: File): Boolean =
         File(filesRoot, TRANSACTION_FILE_NAME).exists()
+
+    /**
+     * Cheap startup integrity check.
+     *
+     * Full SHA-256 verification remains part of installation/update. Startup only verifies
+     * that every required installed pack described by the committed local manifest exists
+     * with the expected byte length, avoiding hundreds of MiB of hashing on the main thread.
+     */
+    internal fun installedRuntimeLooksComplete(filesRoot: File): Boolean {
+        if (transactionInProgress(filesRoot)) return false
+        val root = File(filesRoot, "runtime")
+        val localManifest = File(root, "manifest.json")
+        if (!localManifest.isFile) return false
+        val manifest = runCatching {
+            RuntimeManifestSpec.parse(localManifest.readText())
+        }.getOrNull() ?: return false
+        return manifest.packs
+            .asSequence()
+            .filter(RuntimePackSpec::required)
+            .all { pack ->
+                val installed = runCatching { resolveWithin(root, pack.installAs) }.getOrNull()
+                    ?: return@all false
+                installed.isFile && installed.length() == pack.rawBytes
+            }
+    }
+
     /** Restores the last complete runtime if the process stopped during the short commit window. */
     internal fun recoverInterruptedInstall(filesRoot: File) {
