+package app.humanrouter
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+import java.nio.file.Files
+
+class RuntimeInstallerStateTest {
+    @Test
+    fun requiredPacksMustExistWithExpectedSize() {
+        val filesRoot = Files.createTempDirectory("vh-runtime-state").toFile()
+        try {
+            val runtime = File(filesRoot, "runtime").apply { mkdirs() }
+            File(runtime, "manifest.json").writeText(manifest(rawBytes = 4))
+
+            assertFalse(RuntimeInstaller.installedRuntimeLooksComplete(filesRoot))
+
+            val pack = File(runtime, "surface/data.bin").apply {
+                parentFile!!.mkdirs()
+                writeBytes(byteArrayOf(1, 2, 3))
+            }
+            assertFalse(RuntimeInstaller.installedRuntimeLooksComplete(filesRoot))
+
+            pack.writeBytes(byteArrayOf(1, 2, 3, 4))
+            assertTrue(RuntimeInstaller.installedRuntimeLooksComplete(filesRoot))
+
+            File(filesRoot, "runtime-transaction.json").writeText("{}")
+            assertFalse(RuntimeInstaller.installedRuntimeLooksComplete(filesRoot))
+        } finally {
+            filesRoot.deleteRecursively()
+        }
+    }
+
+    @Test
+    fun malformedLocalManifestIsNotUsable() {
+        val filesRoot = Files.createTempDirectory("vh-runtime-state").toFile()
+        try {
+            val runtime = File(filesRoot, "runtime").apply { mkdirs() }
+            File(runtime, "manifest.json").writeText("{not-json")
+            assertFalse(RuntimeInstaller.installedRuntimeLooksComplete(filesRoot))
+        } finally {
+            filesRoot.deleteRecursively()
+        }
+    }
+
+    private fun manifest(rawBytes: Long): String = """
+        {
+          "version": "test",
+          "total_download_bytes": 4,
+          "packs": [
+            {
+              "file": "data.bin",
+              "install_as": "surface/data.bin",
+              "compression": "none",
+              "sha256_compressed": "${"a".repeat(64)}",
+              "compressed_bytes": 4,
+              "sha256_raw": "${"b".repeat(64)}",
+              "raw_bytes": $rawBytes,
+              "required": true
+            }
+          ]
+        }
+    """.trimIndent()
+}
