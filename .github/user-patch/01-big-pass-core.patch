diff --git a/.github/scripts/android_emulator_smoke.sh b/.github/scripts/android_emulator_smoke.sh
--- a/.github/scripts/android_emulator_smoke.sh
+++ b/.github/scripts/android_emulator_smoke.sh
@@
 mkdir -p "$output_dir"

+diagnostics_captured=false
+capture_failure_diagnostics() {
+  if [[ "$diagnostics_captured" == true ]]; then
+    return
+  fi
+  diagnostics_captured=true
+  adb logcat -d -v threadtime >"$output_dir/failure-logcat.txt" 2>&1 || true
+  adb shell dumpsys window windows >"$output_dir/failure-window.txt" 2>&1 || true
+  adb shell dumpsys window displays >>"$output_dir/failure-window.txt" 2>&1 || true
+  adb shell dumpsys activity activities >"$output_dir/failure-activity.txt" 2>&1 || true
+  adb exec-out screencap -p >"$output_dir/failure-screen.png" 2>/dev/null || true
+  adb shell uiautomator dump /sdcard/vremyahodom-failure.xml >/dev/null 2>&1 || true
+  adb pull /sdcard/vremyahodom-failure.xml "$output_dir/failure-window.xml" >/dev/null 2>&1 || true
+}
+on_exit() {
+  local status=$?
+  if (( status != 0 )); then
+    capture_failure_diagnostics
+  fi
+  exit "$status"
+}
+trap on_exit EXIT
+
 adb wait-for-device
@@
 if (( instrumentation_status != 0 )); then
   exit "$instrumentation_status"
